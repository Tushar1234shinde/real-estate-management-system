generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -------------------- ENUMS --------------------

enum RoleName {
  ADMIN
  EXECUTIVE
  INSIDE_SALES
  OUTSIDE_SALES
}

enum CustomerInterestStatus {
  PENDING
  INTERESTED
  NOT_INTERESTED
}

enum CustomerStatus {
  NEW
  ASSIGNED
  CONTACTED
  CONVERTED
  CLOSED
}

enum PropertyStatus {
  AVAILABLE
  BOOKED
  SOLD
  INACTIVE
}

enum AssignmentStatus {
  ASSIGNED
}

enum CallOutcome {
  INTERESTED
  NOT_INTERESTED
  NO_ANSWER
  CALL_BACK
  INVALID_NUMBER
}

enum VisitScheduleStatus {
  SCHEDULED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum VisitStatus {
  IN_PROGRESS
  PENDING_REVIEW
  COMPLETED
  REJECTED
  CANCELLED
}

enum VisitVerificationResult {
  PENDING
  PASSED
  FAILED
}

enum MediaType {
  AUDIO_RECORDING
  VISIT_SELFIE
  CUSTOMER_SELFIE
  OTHER
}

enum AttendanceStatus {
  LOGGED_IN
  LOGGED_OUT
  AUTO_LOGGED_OUT
}

enum LogoutReason {
  MANUAL
  GEOFENCE_EXIT
  ADMIN_ACTION
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
}

enum WhatsAppMessageType {
  INTERESTED_THANK_YOU
  NOT_INTERESTED_FOLLOW_UP
  PROPERTY_DOCUMENT
  GENERAL_UPDATE
  HOLIDAY_MESSAGE
}

enum MessageDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppOutboxStatus {
  PENDING
  PROCESSING
  SUBMITTING
  SENT
  FAILED
  CANCELLED
  UNKNOWN
}

enum WhatsAppConsentStatus {
  OPTED_IN
  OPTED_OUT
}

enum WhatsAppInboundProcessingClassification {
  NORMAL
  OPT_OUT
  OPT_IN
  STALE_OPT_IN
  UNMATCHED
  UNSUPPORTED
}

// -------------------- ROLES & USERS --------------------

model Role {
  id          Int      @id @default(autoincrement())
  name        RoleName @unique
  description String?

  users User[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("roles")
}

model User {
  id              Int     @id @default(autoincrement())
  roleId          Int
  fullName        String
  email           String  @unique
  passwordHash    String
  phone           String? @unique
  profileImageUrl String?
  isActive        Boolean @default(true)

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  assignmentsReceived CustomerAssignment[] @relation("InsideSalesAssignment")
  assignmentsMade     CustomerAssignment[] @relation("AssignmentCreatedBy")

  calls            CallLog[]
  attendance       Attendance[]
  notifications    Notification[]
  announcementsCreated Announcement[]     @relation("AnnouncementCreatedBy")
  announcementReads    AnnouncementRead[]
  whatsappMessages WhatsAppMessageLog[] @relation("MessageTriggeredBy")

  insideSalesSchedules  VisitSchedule[] @relation("InsideSalesSchedule")
  outsideSalesSchedules VisitSchedule[] @relation("OutsideSalesSchedule")
  schedulesCreated      VisitSchedule[] @relation("ScheduleCreatedBy")

  uploadedMedia           MediaAsset[]
  uploadedDocuments       PropertyDocument[]
  whatsappConsentEvents   WhatsAppConsentEvent[]       @relation("WhatsAppConsentRecordedBy")
  whatsappIdempotencyKeys WhatsAppMessageIdempotency[]
  reviewedVisits          Visit[]                      @relation("VisitReviewedBy")
  visitStatusChanges      VisitStatusHistory[]         @relation("VisitStatusChangedBy")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([roleId])
  @@map("users")
}

// -------------------- CUSTOMERS --------------------

model Customer {
  id                    Int                    @id @default(autoincrement())
  fullName              String
  email                 String?
  phone                 String
  address               String?
  status                CustomerStatus         @default(NEW)
  interestStatus        CustomerInterestStatus @default(PENDING)
  lastWhatsappInboundAt DateTime?              @db.Timestamptz(3)

  assignment                        CustomerAssignment?
  calls                             CallLog[]
  visitSchedules                    VisitSchedule[]
  whatsappMessages                  WhatsAppMessageLog[]
  whatsappConsentEvents             WhatsAppConsentEvent[]
  whatsappInboundEvents             WhatsAppInboundMessageEvent[]
  whatsappMessageIdempotencyRecords WhatsAppMessageIdempotency[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([phone])
  @@index([status, interestStatus])
  @@map("customers")
}

// -------------------- CUSTOMER ASSIGNMENTS --------------------

model CustomerAssignment {
  id                    Int              @id @default(autoincrement())
  customerId            Int              @unique
  insideSalesEmployeeId Int
  assignedByUserId      Int
  assignedAt            DateTime         @default(now()) @db.Timestamptz(3)
  status                AssignmentStatus @default(ASSIGNED)

  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  insideSalesEmployee User     @relation("InsideSalesAssignment", fields: [insideSalesEmployeeId], references: [id], onDelete: Restrict)
  assignedBy          User     @relation("AssignmentCreatedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@index([insideSalesEmployeeId])
  @@index([assignedByUserId])
  @@map("customer_assignments")
}

// -------------------- PROPERTIES --------------------

model Property {
  id                       Int            @id @default(autoincrement())
  title                    String
  description              String?
  location                 String
  latitude                 Float?
  longitude                Float?
  verificationRadiusMeters Int            @default(200)
  price                    Decimal        @db.Decimal(12, 2)
  status                   PropertyStatus @default(AVAILABLE)

  documents      PropertyDocument[]
  calls          CallLog[]
  visitSchedules VisitSchedule[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@map("properties")
}

model PropertyDocument {
  id               Int      @id @default(autoincrement())
  propertyId       Int
  uploadedByUserId Int
  documentName     String
  documentUrl      String
  publicId         String?  @unique(map: "property_documents_publicId_key")
  assetId          String?  @unique(map: "property_documents_assetId_key")
  resourceType     String?
  deliveryType     String?
  fileSizeBytes    BigInt?
  mimeType         String?
  uploadedAt       DateTime @default(now()) @db.Timestamptz(3)

  property           Property                    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  uploadedBy         User                        @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  messageAttachments WhatsAppMessageAttachment[]

  @@index([propertyId])
  @@index([uploadedByUserId])
  @@map("property_documents")
}

// -------------------- CALL LOGS --------------------

model CallLog {
  id         Int         @id @default(autoincrement())
  customerId Int
  employeeId Int
  propertyId Int?
  outcome    CallOutcome
  notes      String?
  calledAt   DateTime    @default(now()) @db.Timestamptz(3)

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  employee User      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([customerId, calledAt])
  @@index([employeeId, calledAt])
  @@index([propertyId])
  @@map("call_logs")
}

// -------------------- VISIT SCHEDULES --------------------

model VisitSchedule {
  id                     Int                 @id @default(autoincrement())
  customerId             Int
  propertyId             Int
  insideSalesEmployeeId  Int
  outsideSalesEmployeeId Int
  scheduledByUserId      Int
  scheduledAt            DateTime            @db.Timestamptz(3)
  status                 VisitScheduleStatus @default(SCHEDULED)
  notes                  String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  insideSalesEmployee  User @relation("InsideSalesSchedule", fields: [insideSalesEmployeeId], references: [id], onDelete: Restrict)
  outsideSalesEmployee User @relation("OutsideSalesSchedule", fields: [outsideSalesEmployeeId], references: [id], onDelete: Restrict)
  scheduledBy          User @relation("ScheduleCreatedBy", fields: [scheduledByUserId], references: [id], onDelete: Restrict)

  visit Visit?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([outsideSalesEmployeeId, scheduledAt])
  @@index([insideSalesEmployeeId])
  @@index([customerId])
  @@index([propertyId])
  @@index([scheduledByUserId])
  @@map("visit_schedules")
}

// -------------------- VISITS --------------------

model Visit {
  id                         Int                     @id @default(autoincrement())
  scheduleId                 Int                     @unique
  // Coordinates captured for the property-location verification attempt.
  reachedAt                  DateTime?               @db.Timestamptz(3)
  completedAt                DateTime?               @db.Timestamptz(3)
  status                     VisitStatus             @default(IN_PROGRESS)
  reachedLatitude            Float?
  reachedLongitude           Float?
  verificationResult         VisitVerificationResult @default(PENDING)
  verificationCheckedAt      DateTime?               @db.Timestamptz(3)
  verificationDistanceMeters Float?
  reviewerId                 Int?
  reviewedAt                 DateTime?               @db.Timestamptz(3)
  rejectionReason            String?

  schedule      VisitSchedule        @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  mediaAssets   MediaAsset[]
  reviewer      User?                @relation("VisitReviewedBy", fields: [reviewerId], references: [id], onDelete: Restrict)
  statusHistory VisitStatusHistory[]

  @@index([reviewerId])
  @@map("visits")
}

// -------------------- MEDIA ASSETS --------------------

model MediaAsset {
  id               Int       @id @default(autoincrement())
  visitId          Int
  uploadedByUserId Int
  mediaType        MediaType
  fileUrl          String
  publicId         String?
  assetId          String?
  resourceType     String?
  deliveryType     String?
  mimeType         String?
  fileSizeBytes    BigInt?
  durationSeconds  Int?
  uploadedAt       DateTime  @default(now()) @db.Timestamptz(3)

  visit      Visit @relation(fields: [visitId], references: [id], onDelete: Restrict)
  uploadedBy User  @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([visitId, mediaType])
  @@index([uploadedByUserId])
  @@map("media_assets")
}

model VisitStatusHistory {
  id              Int          @id @default(autoincrement())
  visitId         Int
  previousStatus  VisitStatus?
  newStatus       VisitStatus
  changedByUserId Int
  reason          String?
  changedAt       DateTime     @default(now()) @db.Timestamptz(3)

  visit         Visit @relation(fields: [visitId], references: [id], onDelete: Restrict)
  changedByUser User  @relation("VisitStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([visitId, changedAt])
  @@index([changedByUserId])
  @@map("visit_status_history")
}

// -------------------- OFFICE & ATTENDANCE --------------------

model OfficeLocation {
  id                  Int     @id @default(autoincrement())
  officeName          String
  address             String?
  latitude            Float
  longitude           Float
  allowedRadiusMeters Int     @default(200)
  isActive            Boolean @default(true)

  attendance Attendance[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("office_locations")
}

model Attendance {
  id               Int              @id @default(autoincrement())
  employeeId       Int
  officeLocationId Int
  loginTime        DateTime         @default(now()) @db.Timestamptz(3)
  logoutTime       DateTime?        @db.Timestamptz(3)
  loginLatitude    Float
  loginLongitude   Float
  logoutLatitude   Float?
  logoutLongitude  Float?
  status           AttendanceStatus @default(LOGGED_IN)
  logoutReason     LogoutReason?

  employee       User           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  officeLocation OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Restrict)

  @@index([employeeId, loginTime])
  @@index([officeLocationId])
  @@map("attendance")
}

// -------------------- ANNOUNCEMENTS --------------------

model Announcement {
  id          Int                  @id @default(autoincrement())
  title       String
  content     String
  category    String
  priority    AnnouncementPriority @default(NORMAL)
  isPublished Boolean              @default(false)
  expiresAt   DateTime?            @db.Timestamptz(3)
  createdById Int

  createdBy User               @relation("AnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  targetRoles RoleName[]       @default([])
  reads       AnnouncementRead[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([isPublished, expiresAt, createdAt])
  @@index([createdById])
  @@map("announcements")
}

model AnnouncementRead {
  id             Int      @id @default(autoincrement())
  announcementId Int
  userId         Int
  readAt         DateTime @default(now()) @db.Timestamptz(3)

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, readAt])
  @@map("announcement_reads")
}

// -------------------- WHATSAPP MESSAGES --------------------

model WhatsAppMessageLog {
  id                Int                   @id @default(autoincrement())
  customerId        Int
  triggeredByUserId Int?
  messageType       WhatsAppMessageType
  messageContent    String
  providerMessageId String?               @unique
  deliveryStatus    MessageDeliveryStatus @default(PENDING)
  sentAt            DateTime?             @db.Timestamptz(3)
  statusUpdatedAt   DateTime?             @db.Timestamptz(3)

  customer          Customer                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  triggeredBy       User?                        @relation("MessageTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  attachments       WhatsAppMessageAttachment[]
  statusEvents      WhatsAppMessageStatusEvent[]
  outbox            WhatsAppMessageOutbox?
  idempotencyRecord WhatsAppMessageIdempotency?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([customerId, createdAt])
  @@index([deliveryStatus])
  @@index([triggeredByUserId])
  @@map("whatsapp_message_logs")
}

model WhatsAppMessageOutbox {
  id                  Int                  @id @default(autoincrement())
  messageLogId        Int                  @unique
  status              WhatsAppOutboxStatus @default(PENDING)
  claimToken          String?              @unique
  attemptCount        Int                  @default(0)
  nextAttemptAt       DateTime             @default(now()) @db.Timestamptz(3)
  processingStartedAt DateTime?            @db.Timestamptz(3)
  submissionStartedAt DateTime?            @db.Timestamptz(3)
  completedAt         DateTime?            @db.Timestamptz(3)
  lastErrorCode       String?

  messageLog WhatsAppMessageLog @relation(fields: [messageLogId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt, id])
  @@index([status, nextAttemptAt, createdAt, id])
  @@index([status, processingStartedAt])
  @@index([status, submissionStartedAt])
  @@map("whatsapp_message_outbox")
}

model WhatsAppMessageIdempotency {
  id                 Int    @id @default(autoincrement())
  senderUserId       Int
  customerId         Int
  idempotencyKey     String @db.VarChar(128)
  payloadFingerprint String @db.Char(64)
  messageLogId       Int    @unique

  sender     User               @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  messageLog WhatsAppMessageLog @relation(fields: [messageLogId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([senderUserId, customerId, idempotencyKey], map: "whatsapp_message_idempotency_senderUserId_customerId_idempotenc")
  @@map("whatsapp_message_idempotency")
}

model WhatsAppPendingStatusEvent {
  id                Int                   @id @default(autoincrement())
  providerMessageId String
  status            MessageDeliveryStatus
  providerTimestamp DateTime              @db.Timestamptz(3)
  providerErrorCode String?               @db.VarChar(100)
  receivedAt        DateTime              @default(now()) @db.Timestamptz(3)

  @@unique([providerMessageId, status, providerTimestamp], map: "whatsapp_pending_status_events_providerMessageId_status_provide")
  @@index([providerMessageId, providerTimestamp], map: "whatsapp_pending_status_events_providerMessageId_providerTimest")
  @@map("whatsapp_pending_status_events")
}

model WhatsAppConsentEvent {
  id                    Int                   @id @default(autoincrement())
  customerId            Int
  recordedByUserId      Int?
  inboundMessageEventId Int?                  @unique
  status                WhatsAppConsentStatus
  source                String
  consentAt             DateTime              @default(now()) @db.Timestamptz(3)
  recordedAt            DateTime              @default(now()) @db.Timestamptz(3)

  customer            Customer                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  recordedBy          User?                        @relation("WhatsAppConsentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  inboundMessageEvent WhatsAppInboundMessageEvent? @relation(fields: [inboundMessageEventId], references: [id], onDelete: SetNull)

  @@index([customerId, recordedAt])
  @@index([recordedByUserId])
  @@map("whatsapp_consent_events")
}

model WhatsAppInboundMessageEvent {
  id                       Int                                     @id @default(autoincrement())
  providerMessageId        String                                  @unique
  customerId               Int?
  senderPhone              String
  providerTimestamp        DateTime                                @db.Timestamptz(3)
  messageType              String
  processingClassification WhatsAppInboundProcessingClassification
  receivedAt               DateTime                                @default(now()) @db.Timestamptz(3)

  customer     Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  consentEvent WhatsAppConsentEvent?

  @@index([customerId, providerTimestamp], map: "whatsapp_inbound_message_events_customerId_providerTimestamp_id")
  @@index([senderPhone, providerTimestamp], map: "whatsapp_inbound_message_events_senderPhone_providerTimestamp_i")
  @@map("whatsapp_inbound_message_events")
}

model WhatsAppMessageStatusEvent {
  id                Int                   @id @default(autoincrement())
  messageLogId      Int
  status            MessageDeliveryStatus
  providerTimestamp DateTime              @db.Timestamptz(3)
  receivedAt        DateTime              @default(now()) @db.Timestamptz(3)
  providerErrorCode String?

  messageLog WhatsAppMessageLog @relation(fields: [messageLogId], references: [id], onDelete: Restrict)

  @@unique([messageLogId, status, providerTimestamp], map: "whatsapp_message_status_events_messageLogId_status_providerTime")
  @@index([messageLogId, providerTimestamp], map: "whatsapp_message_status_events_messageLogId_providerTimestamp_i")
  @@map("whatsapp_message_status_events")
}

model WhatsAppMessageAttachment {
  id                 Int @id @default(autoincrement())
  messageId          Int
  propertyDocumentId Int

  message          WhatsAppMessageLog @relation(fields: [messageId], references: [id], onDelete: Restrict)
  propertyDocument PropertyDocument   @relation(fields: [propertyDocumentId], references: [id], onDelete: Restrict)

  @@unique([messageId, propertyDocumentId])
  @@index([propertyDocumentId])
  @@map("whatsapp_message_attachments")
}

// -------------------- NOTIFICATIONS --------------------

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}
