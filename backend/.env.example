DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/real_estate_db?schema=public"
# Used only by integration test commands; the database name must end in _integration_test.
TEST_DATABASE_URL="postgresql://TEST_USER:TEST_PASSWORD@localhost:5432/real_estate_integration_test?schema=public"
INTEGRATION_TESTS_ENABLED="false"
TEST_DATABASE_ALLOWED_HOSTS="localhost"

ADMIN_NAME="System Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-your-local-admin-password"
JWT_SECRET="replace-with-a-random-secret"
JWT_EXPIRES_IN="1h"
JWT_ISSUER="real-estate-management-system"
JWT_AUDIENCE="real-estate-management-system-api"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Regular application Cloudinary configuration. Do not use these for real integration tests.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_EVIDENCE_FOLDER="visit-evidence"
CLOUDINARY_EVIDENCE_ACCESS_TTL_SECONDS="300"

# Meta WhatsApp Cloud API. Configure real values only in an ignored local .env
# file or a deployment secret store.
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_VERIFY_TOKEN=""
META_WHATSAPP_APP_SECRET=""
META_GRAPH_API_VERSION=""

# Real Cloudinary integration tests are disabled by default. Set these only in
# an ignored local .env file or CI secret store, using a dedicated non-production
# Cloudinary environment. The test runner refuses to use regular Cloudinary values.
CLOUDINARY_TEST_ENABLED="false"
CLOUDINARY_TEST_CLOUD_NAME=""
CLOUDINARY_TEST_API_KEY=""
CLOUDINARY_TEST_API_SECRET=""
CLOUDINARY_TEST_FOLDER_PREFIX="stage7c"

SELFIE_MAX_FILE_SIZE_BYTES="5242880"
AUDIO_MAX_FILE_SIZE_BYTES="15728640"
